---
/**
 * Molde da Página de tarefa (ADR 0057, decisões 2 e 4).
 *
 * Os selos de quem faz saem do frontmatter, desenhados aqui, para o Markdown
 * de cada página ficar só com o texto: quando usar, passo a passo e se der
 * errado. Página sem `papel` não é Página de tarefa (é Visão geral, Como
 * funciona ou Novidades) e passa direto. O Vídeo de visão geral também sai do
 * frontmatter, só na abertura do módulo e na página inicial.
 *
 * O corpo da Página de tarefa vai dentro de `.tarefa-corpo`, que é onde o tema
 * numera os passos com o número grande e acomoda o Print de passo dentro do
 * item da lista (emenda de 17/09/2026, decisão 2). Nada disso aparece no
 * Markdown da página.
 *
 * A busca afinada (issue #1221) também sai daqui, para toda página de módulo:
 * o nome do módulo vai como metadado do Pagefind (o resultado mostra
 * "Módulo: Ouvidoria"), as palavras de `busca:` entram no índice num trecho
 * que a tela não mostra, e `proximas:` vira o bloco "Tarefas próximas" no fim
 * da Página de tarefa.
 */
import { getEntry } from "astro:content";
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { modulos } from "../modulos.mjs";

const { entry } = Astro.locals.starlightRoute;
const dados = entry.data as {
  papel?: string[];
  login?: boolean;
  video?: string;
  busca?: string[];
  proximas?: string[];
};

const papeis = dados.papel ?? [];
const eTarefa = papeis.length > 0;
// `login: false` é a tela que a pessoa abre por link ou QR, sem entrar no app.
const selos = dados.login === false ? [...papeis, "Sem login"] : papeis;
const modulo = entry.id.split("/")[0];
// A abertura do módulo tem o id do próprio módulo (`ouvidoria`), e a página
// inicial tem o id `index`. Só elas mostram vídeo, e a página inicial mostra o
// de Primeiros passos (emenda de 14/10/2026 à ADR 0057).
const eAbertura = !eTarefa && !entry.id.includes("/");
const pastaDoVideo = entry.id === "index" ? "primeiros-passos" : modulo;
// Home e páginas fora dos módulos não têm módulo para mostrar.
const rotuloDoModulo = modulos.find((m) => m.pasta === modulo)?.label;
const busca = dados.busca ?? [];

// Tarefa em draft não existe no ar: vira link só o que está publicado.
const proximas: { href: string; titulo: string }[] = [];
for (const slug of eTarefa ? (dados.proximas ?? []) : []) {
  const pagina = await getEntry("docs", `${modulo}/${slug}`);
  if (pagina && !pagina.data.draft) {
    proximas.push({ href: `/${pagina.id}/`, titulo: pagina.data.title });
  }
}

function classeDoSelo(selo: string) {
  if (selo === "Sem login") return "tarefa-selo tarefa-selo--sem-login";
  if (selo === "Só admin") return "tarefa-selo tarefa-selo--admin";
  return "tarefa-selo";
}
---

{
  eTarefa && (
    <div class="tarefa-selos">
      {selos.map((selo) => (
        <span class={classeDoSelo(selo)}>{selo}</span>
      ))}
    </div>
  )
}
{
  /* O Vídeo de visão geral do módulo, na abertura. Abertura sem vídeo publica
     sem dizer nada; a lacuna é cobrada pelo inventário da /montar-manual.
     Página de tarefa não exibe vídeo (emenda de 14/10/2026 à ADR 0057).

     A capa é o primeiro quadro do MP4, gerada pelo `publicar.sh`. No `pnpm dev`
     ela não existe, e o navegador simplesmente ignora um `poster` que não
     carrega. */
}
{
  eAbertura && dados.video && (
    <div class="abertura-video">
      <video
        controls
        muted
        playsinline
        preload="metadata"
        poster={`/video/${pastaDoVideo}/${dados.video}.jpg`}
      >
        <source
          src={`/video/${pastaDoVideo}/${dados.video}.mp4`}
          type="video/mp4"
        />
      </video>
    </div>
  )
}
<div
  class={eTarefa ? "tarefa-corpo" : undefined}
  data-pagefind-meta={rotuloDoModulo ? `módulo:${rotuloDoModulo}` : undefined}
>
  {
    /* Só para o índice da busca: a tela esconde, o leitor de tela pula. Vem
       antes do texto para o resultado apontar o topo da página, e não a
       última seção dela. */
    busca.length > 0 && (
      <p class="busca-sinonimos" aria-hidden="true">
        {busca.join(", ")}
      </p>
    )
  }
  <Default><slot /></Default>
</div>
{
  proximas.length > 0 && (
    <nav
      class="tarefas-proximas"
      aria-labelledby="tarefas-proximas"
      data-pagefind-ignore
    >
      <h2 id="tarefas-proximas">Tarefas próximas</h2>
      <ul>
        {proximas.map(({ href, titulo }) => (
          <li>
            <a href={href}>{titulo}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
