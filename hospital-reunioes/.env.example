# === App ===
# "production" bloqueia ClickSign sandbox e ativa validações extras
ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET_AUDIOS=audios
SUPABASE_STORAGE_BUCKET_TRANSCRICOES=transcricoes
SUPABASE_STORAGE_BUCKET_PDFS=pdfs
SUPABASE_STORAGE_BUCKET_PDFS_ASSINADOS=pdfs-assinados

# === Supabase (Frontend - Next.js) ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_ENVIRONMENT=production

# === LLM (OpenRouter primário; OpenAI direto como fallback) ===
OPENROUTER_API_KEY=your-openrouter-key
LLM_MODEL=openai/gpt-5.4-mini
# Fallback: usado se OPENROUTER_API_KEY estiver vazia
OPENAI_API_KEY=
LLM_FALLBACK_MODEL=gpt-4o-mini

# === Fireflies.ai ===
FIREFLIES_API_KEY=your-fireflies-key
FIREFLIES_WEBHOOK_SECRET=your-webhook-secret

# === ClickSign ===
CLICKSIGN_API_KEY=your-clicksign-key
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
CLICKSIGN_WEBHOOK_SECRET=your-clicksign-webhook-secret

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=reunioes@hospital.com

# === Geral ===
DIRETOR_EMAIL=diretor@hospital.com

# === Segurança ===
# Senha padrão ao provisionar novos usuários (se vazio, gera senha aleatória por usuário)
DEFAULT_USER_PASSWORD=

# === API da Ana (ADR 0031) ===
# API key de serviço da agente Ana (header X-API-Key). Vazia = API desabilitada.
ANA_API_KEY=

# === Email (Resend) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@hospitalsaomatheus.com.br
