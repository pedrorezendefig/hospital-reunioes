# Hospital Reunioes — frontend env vars
# Next.js inline NEXT_PUBLIC_* no bundle JS durante build.
# No Coolify: criar com is_build_time=true (Dockerfile recebe via ARG).

NEXT_PUBLIC_SUPABASE_URL=<PREENCHER>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<PREENCHER>

# Em prod: https://api.hospitalsaomatheus.cloud/api ; em dev: http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# development | production
NEXT_PUBLIC_ENVIRONMENT=development
