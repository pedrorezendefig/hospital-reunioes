# Hospital Reuniões: frontend env vars (pnpm dev sem Docker; copie para frontend/.env.local)
# Next.js inline NEXT_PUBLIC_* no bundle JS durante build.
# No Coolify: criar com is_build_time=true (Dockerfile recebe via ARG).

NEXT_PUBLIC_SUPABASE_URL=<PREENCHER>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<PREENCHER>

# Em prod: https://api.hospitalsaomatheus.cloud/api ; em dev: http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# development | production
NEXT_PUBLIC_ENVIRONMENT=development

# URL interna do backend para o rewrite /api no servidor Next (issue #349).
# Vazio = usa NEXT_PUBLIC_API_URL. No Coolify é build variable: http://<container-backend>:8000/api
API_PROXY_URL=

# NEXT_PUBLIC_APP_VERSION é injetado automaticamente pelo next.config.ts a partir de package.json.
# Não precisa setar manualmente nem no Coolify: é build-time inlined.
