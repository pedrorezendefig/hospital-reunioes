# Hospital Reunioes — backend env vars
# Copie para hospital-reunioes/.env (raiz do submodulo, NAO backend/.env) e preencha.
# Este arquivo deve refletir 1:1 os atributos de app/config.py:Settings.

# === Ambiente ===
ENVIRONMENT=development
DEBUG=false
ENABLE_BYPASS_ENDPOINTS=false

# === Supabase ===
SUPABASE_URL=<PREENCHER>
SUPABASE_SERVICE_ROLE_KEY=<PREENCHER>
SUPABASE_STORAGE_BUCKET_AUDIOS=audios
SUPABASE_STORAGE_BUCKET_TRANSCRICOES=transcricoes
SUPABASE_STORAGE_BUCKET_PDFS=pdfs
SUPABASE_STORAGE_BUCKET_PDFS_ASSINADOS=pdfs-assinados

# === OpenAI ===
OPENAI_API_KEY=<PREENCHER>

# === Fireflies (opcional, fallback de transcricao) ===
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=

# === ClickSign ===
CLICKSIGN_API_KEY=<PREENCHER>
# Sandbox em dev, app.clicksign.com em prod (validado por config.py)
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
CLICKSIGN_WEBHOOK_SECRET=<AUTO-GERADO pela skill /deploy>

# === Email — Resend (preferido) ===
RESEND_API_KEY=<PREENCHER>
RESEND_FROM_EMAIL=noreply@hospitalsaomatheus.com.br

# === Email — SMTP legacy (fallback local, opcional) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# === Geral ===
DIRETOR_EMAIL=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEFAULT_USER_PASSWORD=

# === Secrets auto-gerados (skill /deploy gera e seta no Coolify) ===
SIGNUP_PASSE=<AUTO-GERADO pela skill /deploy>
SIGNUP_ENCRYPTION_KEY=<AUTO-GERADO pela skill /deploy>
