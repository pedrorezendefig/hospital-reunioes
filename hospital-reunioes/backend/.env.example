# Hospital Reuniões: espelho 1:1 de app/config.py:Settings (o gate
# env_example_sync do /deploy compara os dois). NÃO é o arquivo que o backend
# lê: ele lê hospital-reunioes/.env, cujo molde é hospital-reunioes/.env.example
# (este conteúdo mais as chaves NEXT_PUBLIC_* do frontend).

# === App ===
# Versão exibida no /api/health. Em prod o /deploy injeta a do frontend/package.json.
APP_VERSION=0.1.0
DEBUG=false
# Conhecidos: development, ci, staging, production (outro valor recusa subir).
# Default do código é production; local declara development (issue #450).
APP_NAME=Hospital Reuniões API
API_PREFIX=/api
ENVIRONMENT=development

# === Supabase ===
SUPABASE_URL=<PREENCHER>
SUPABASE_SERVICE_ROLE_KEY=<PREENCHER>
SUPABASE_STORAGE_BUCKET_AUDIOS=audios
SUPABASE_STORAGE_BUCKET_TRANSCRICOES=transcricoes
SUPABASE_STORAGE_BUCKET_PDFS=pdfs
SUPABASE_STORAGE_BUCKET_PDFS_ASSINADOS=pdfs-assinados
SUPABASE_STORAGE_BUCKET_MATERIAIS_POPS=materiais-pops
SUPABASE_STORAGE_BUCKET_ANEXOS_OUVIDORIA=anexos-ouvidoria

# === LLM (OpenRouter, provedor único; chave vazia = mock) ===
OPENROUTER_API_KEY=<PREENCHER>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.4-mini
TRANSCRICAO_MODEL=openai/gpt-4o-mini-transcribe

# === Fireflies (opcional, fallback de transcrição) ===
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=

# === ClickSign ===
CLICKSIGN_API_KEY=<PREENCHER>
# sandbox em dev; app.clicksign.com só em production (validado por config.py)
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
CLICKSIGN_WEBHOOK_SECRET=

# === API da Ana (ADR 0031): header X-API-Key. Vazia = API desabilitada. ===
ANA_API_KEY=

# === Espelho da Global Health (ADR 0038): token da agenda de HOMOLOGAÇÃO. ===
GH_TOKEN_HOMOLOG=

# === Email: Resend (preferido) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@hospitalsaomatheus.cloud

# === Email: SMTP (fallback local, opcional) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# === Ouvidoria ===
# Freio do job de retenção (issue #343). false + restart para o job sem deploy.
OUVIDORIA_RETENCAO_ATIVA=true

# === Geral ===
DIRETOR_EMAIL=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEFAULT_USER_PASSWORD=
