# Hospital Reuniões: espelho 1:1 de app/config.py:Settings (o gate
# env_example_sync do /deploy compara os dois). NÃO é o arquivo que o backend
# lê: ele lê hospital-reunioes/.env, cujo molde é hospital-reunioes/.env.example
# (este conteúdo mais as chaves NEXT_PUBLIC_* do frontend).

# === App ===
# Versão exibida no /api/health. Em prod o /deploy injeta a do frontend/package.json.
APP_VERSION=0.1.0
DEBUG=false
# Conhecidos: development, ci, staging, production (outro valor recusa subir).
# Default do código é production; local declara development (issue #450).
APP_NAME=Hospital Reuniões API
API_PREFIX=/api
ENVIRONMENT=development

# === Supabase ===
SUPABASE_URL=<PREENCHER>
SUPABASE_SERVICE_ROLE_KEY=<PREENCHER>
SUPABASE_STORAGE_BUCKET_AUDIOS=audios
SUPABASE_STORAGE_BUCKET_TRANSCRICOES=transcricoes
SUPABASE_STORAGE_BUCKET_PDFS=pdfs
SUPABASE_STORAGE_BUCKET_PDFS_ASSINADOS=pdfs-assinados
SUPABASE_STORAGE_BUCKET_MATERIAIS_POPS=materiais-pops
SUPABASE_STORAGE_BUCKET_ANEXOS_OUVIDORIA=anexos-ouvidoria

# === LLM (OpenRouter, provedor único; chave vazia = mock) ===
OPENROUTER_API_KEY=<PREENCHER>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-5.4-mini
TRANSCRICAO_MODEL=openai/gpt-4o-mini-transcribe

# === Fireflies (opcional, fallback de transcrição) ===
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=

# === ClickSign ===
CLICKSIGN_API_KEY=<PREENCHER>
# sandbox em dev; app.clicksign.com só em production (validado por config.py)
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
CLICKSIGN_WEBHOOK_SECRET=

# === API da Ana (ADR 0031): header X-API-Key. Vazia = API desabilitada. ===
ANA_API_KEY=

# === Espelho da Global Health (ADR 0038): token da agenda de HOMOLOGAÇÃO. ===
GH_TOKEN_HOMOLOG=

# === Integração com o GitHub (ADR 0054): token pessoal fine-grained, só neste
# repositório, só Issues: write. Vazio = Vínculo desligado (503 na API). ===
GITHUB_INTEGRACAO_TOKEN=
GITHUB_INTEGRACAO_REPO=pedrorezendefig/hospital-reunioes

# Segredo do webhook do GitHub (issue #678), o mesmo valor colado no cadastro do
# webhook no repositório. Vazio = a rota /api/webhooks/github responde 503.
GITHUB_WEBHOOK_SECRET=

# === Central de Comando (ADR 0058): só Super admin, nasce DORMENTE. ===
# Tudo vazio = Central desligada: a API responde 503 de configuração, nunca
# zero. As credenciais só entram no Coolify na última fatia do PRD #809.
# Google Analytics 4: número da propriedade e o JSON inteiro da chave da
# service account (Leitor na propriedade), numa linha só, entre aspas simples.
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Eventos do Site nos Contatos gerados. Vazio = wa_click e generate_lead.
GA4_EVENTO_WHATSAPP=
GA4_EVENTO_FALE_CONOSCO=
# Instagram: token de longa duração e id da conta profissional.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Conector MCP (WorkOS AuthKit): emissor, JWKS (vazio = <emissor>/oauth2/jwks)
# e endereço do recurso, que é a audiência do token.
MCP_AUTH_ISSUER=
MCP_AUTH_JWKS_URI=
MCP_RESOURCE_URL=
# Aquecimento do cache no boot (issue #867): uma leitura do período padrão de
# cada tela, numa thread, logo depois de subir. false + restart desliga.
# false no localhost: cada restart do --reload seria uma rodada contra a cota.
# Em produção a variável ausente continua ligando a rodada.
CENTRAL_AQUECER_NO_BOOT=false

# === Email: Resend (preferido) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@hospitalsaomatheus.cloud

# === Email: SMTP (fallback local, opcional) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# === Ouvidoria ===
# Freio do job de retenção (issue #343). false + restart para o job sem deploy.
OUVIDORIA_RETENCAO_ATIVA=true

# === Geral ===
DIRETOR_EMAIL=
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEFAULT_USER_PASSWORD=
