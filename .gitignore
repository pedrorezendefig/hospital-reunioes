# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# Claude Code: ignora settings/cache mas mantém as skills do projeto
# versionadas (assim o time compartilha as skills via clone)
.claude/*
!.claude/skills/
!.claude/skills/**

# Superpowers (plugin local)
.superpowers/

# Worktrees
.worktrees/

# docs gerados por plugins
docs/superpowers/

# Planos e specs (arquivos .md na raiz) — transitórios, não versionar
/*.md
# Exceto docs permanentes do projeto
!/CLAUDE.md
!/README.md
!/AGENTS.md
# Glossário de domínio (modelo Pocock) — doc vivo, versionar
!/CONTEXT.md
# Mapa de contextos (Reuniões × POPs, ADR 0007) — doc vivo, versionar
!/CONTEXT-MAP.md
# Docs do impeccable (pbakaus/impeccable) — produto + design system
!/PRODUCT.md
!/DESIGN.md

# Insumos humanos (PDFs, transcrições, atas de migração, rascunhos, dumps de prod).
# Única pasta fora do git para isso (ADR 0044). Cada máquina cria a sua.
/local/

# Pasta central de tokens/chaves do projeto (NUNCA commitar); molde em tokens/.env.example
/tokens/.env



# Material de comunicação (ADR 0044): a composição HyperFrames e o HTML são a
# fonte versionada; MP4 renderizado, renders e node_modules são regeráveis
docs/comunicacao/**/*.mp4
docs/comunicacao/**/renders/
docs/comunicacao/**/node_modules/
docs/comunicacao/**/.vercel/

# Bytecode Python (dashboard local roda direto do fonte)
__pycache__/

# Artefatos de build do Serwist (regravados em todo `next build`) e estado do CLI Supabase
hospital-reunioes/frontend/public/sw.js
hospital-reunioes/frontend/public/swe-worker-*.js
hospital-reunioes/supabase/.branches/

# Caches de ferramenta (elas mesmas se ignoram, mas a regra do projeto não deve depender disso)
.pytest_cache/
.ruff_cache/
.mypy_cache/
