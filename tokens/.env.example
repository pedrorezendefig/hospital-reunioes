# Tokens da MÁQUINA (não do app). Copie para tokens/.env e preencha.
# tokens/.env fica fora do git. ~/.claude/.env pode ser um symlink para ele
# (é assim na máquina do Pedro; ver docs/onboarding/claude-setup.md).
# Rotacionar = editar este arquivo e reabrir o Claude Code.

# Coolify (CLI `coolify`, contexto hsm): usado por /deploy e /ship.
# Gere em Coolify > Keys & Tokens > API tokens, com permissão de deploy.
COOLIFY_ACCESS_TOKEN=
COOLIFY_BASE_URL=https://coolify.hospitalsaomatheus.cloud

# GitHub: PAT clássico com escopo `repo`, usado pelo `gh` e pelas Actions locais.
GITHUB_PERSONAL_ACCESS_TOKEN=

# API da agente Ana (ADR 0031): a MESMA chave que está em ANA_API_KEY no backend
# de produção. Só é necessária para smoke tests contra prod.
ANA_API_KEY=
